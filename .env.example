# Environment Variables Configuration
# Copy this to .env and configure secrets accordingly

# Application Settings
PROJECT_NAME="Secure Cloud Transfer Manager"
VERSION="2.4.0"
ENVIRONMENT="production"

# Cryptographic & Session Keys (Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY="replace_with_strong_random_secret_key"
TOKEN_ENCRYPTION_KEY="replace_with_strong_fernet_compatible_encryption_key"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Database Configuration (PostgreSQL in production, SQLite in development)
DATABASE_URL="sqlite:///./sctm_enterprise.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sctm_db"

# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/v1/accounts/google/callback"

# Microsoft Graph / OneDrive Credentials
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://127.0.0.1:8000/api/v1/accounts/onedrive/callback"

# Dropbox App Credentials
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""
DROPBOX_REDIRECT_URI="http://127.0.0.1:8000/api/v1/accounts/dropbox/callback"
